# LabCare Diagnostics — files excluded from version control.
#
# Everything listed here is regenerable or machine-specific, so it stays out of the
# repository. The production build is produced with `npm run build`, the reference
# screenshots with `node screenshots.cjs`.

# ---------------------------------------------------------------------------
# Dependencies (reinstalled with `npm ci` / `npm install`)
# ---------------------------------------------------------------------------
node_modules/
**/node_modules/

# ---------------------------------------------------------------------------
# Build output — regenerated by `npm run build` (`tsc --noEmit && vite build`)
# ---------------------------------------------------------------------------
dist/
build/

# ---------------------------------------------------------------------------
# Generated verification artefacts
# ---------------------------------------------------------------------------
screenshots/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.vite/

# ---------------------------------------------------------------------------
# Environment & secrets — never commit real values.
# `.env.example` is a documentation template and IS tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Editor and OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
