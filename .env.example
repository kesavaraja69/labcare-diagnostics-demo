# ---------------------------------------------------------------------------
# LabCare Diagnostics — environment template
#
# Copy to `.env` and adjust:   cp .env.example .env
# `.env` is git-ignored and excluded from the Docker build context.
#
# IMPORTANT: this demo needs NO secrets to run. Every value below is a safe
# placeholder. Never commit real credentials, API keys or payment secrets, and
# never put a secret in a VITE_* variable — those are inlined into the browser
# bundle and are public by definition.
# ---------------------------------------------------------------------------

# ===========================================================================
# Web container (docker-compose: web)
# ===========================================================================

# Host port that the site is published on → http://localhost:8585
APP_PORT=8585

# Image tag used by `docker compose build`
LAB_CARE_TAG=local

# ===========================================================================
# Build-time front-end configuration (baked into the static bundle by Vite)
# ===========================================================================

# Public display name.
VITE_APP_NAME=LabCare Diagnostics

# Base URL of the backend API. The demo has no backend; it is a placeholder that
# the real implementation will point at (e.g. https://api.labcare.example/api).
VITE_API_BASE_URL=/api

# Enables the in-browser demo dataset + demo notices. Set to false only once a
# real backend has replaced the local demo store.
VITE_ENABLE_DEMO_MODE=true

# ===========================================================================
# Optional PostgreSQL (docker-compose profile: postgres)
# The current demo does not use a database — these are placeholders for the
# production backend. Choose strong values for anything beyond local use.
# ===========================================================================

POSTGRES_USER=labcare
POSTGRES_PASSWORD=change-me-local-development-only
POSTGRES_DB=labcare

# Only used if you uncomment the loopback-only port bind in docker-compose.yml.
POSTGRES_PORT=5432

# ===========================================================================
# Reserved for the production backend (documented, not consumed by this demo)
# ===========================================================================

# Signing secret for session/JWT authentication — generate with:
#   openssl rand -base64 48
# AUTH_SECRET=replace-me

# Payment gateway (Razorpay) — server-side only, never exposed to the browser.
# RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=replace-me
# RAZORPAY_WEBHOOK_SECRET=replace-me

# Notifications (WhatsApp Cloud API / SMS / email) — server-side only.
# WHATSAPP_TOKEN=replace-me
# WHATSAPP_PHONE_NUMBER_ID=replace-me
# SMTP_URL=smtp://user:password@smtp.example.com:587
